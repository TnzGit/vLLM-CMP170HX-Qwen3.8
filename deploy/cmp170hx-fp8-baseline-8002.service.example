[Unit]
Description=CMP 170HX target-only FP8 correctness control on port 8002
After=network-online.target
Wants=network-online.target
Conflicts=cmp170hx-mixed-fp8-8002.service cmp170hx-mixed-fp8-native-8002.service cmp170hx-mixed-fp8-full-8002.service

[Service]
Type=simple
WorkingDirectory=/home/base-node/.codex_tasks/pixelml-cmp170hx/mixed-fp8-repo
Environment=CUDA_VISIBLE_DEVICES=0
Environment=CUDA_HOME=/home/base-node/.codex_tasks/pixelml-cmp170hx/runtime-v0271/venv/lib/python3.12/site-packages/nvidia/cu13
Environment=PATH=/home/base-node/.codex_tasks/pixelml-cmp170hx/runtime-v0271/venv/lib/python3.12/site-packages/nvidia/cu13/bin:/home/base-node/.codex_tasks/pixelml-cmp170hx/runtime-v0271/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/home/base-node/.codex_tasks/pixelml-cmp170hx/mixed-fp8-test-site
Environment=VENV=/home/base-node/.codex_tasks/pixelml-cmp170hx/runtime-v0271/venv
Environment=MODEL=/home/base-node/models/Qwen3.8-27B-Uncensored-W4A16-RTX3090-MTP4
Environment=SPEC=none
Environment=CTX=cmp-mixed-fp8
Environment=MAX_LEN=65536
Environment=MAX_SEQS=1
Environment=PREFIX_CACHE=0
Environment=VISION=0
Environment=SPEC_ATTN=0
Environment=VLLM_FP8_SPEC_VERIFY=0
Environment=VLLM_ALIGN_HETEROGENEOUS_ATTN_PAGES=0
Environment=CMP_TARGET_ATTN_BACKEND=FLASHINFER
Environment=CMP_TARGET_KV_DTYPE=fp8
Environment=PORT=8002
Environment=GPU_UTIL=0.90
Environment=KV_MEM=
Environment=VLLM_API_KEY=
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Environment=FLASHINFER_DISABLE_VERSION_CHECK=1
Environment="EXTRA_ARGS=--enforce-eager --enable-prompt-tokens-details"
ExecStartPre=/usr/bin/sudo -n /usr/bin/nvidia-smi -i 0 -pl 180
ExecStartPre=/home/base-node/.codex_tasks/pixelml-cmp170hx/setup_pixelml_cuda_links.sh
ExecStart=/bin/bash /home/base-node/.codex_tasks/pixelml-cmp170hx/mixed-fp8-repo/single-user/start_qwen.sh
Restart=no
TimeoutStopSec=90
KillMode=control-group
StandardOutput=append:/home/base-node/.codex_tasks/pixelml-cmp170hx/fp8-baseline-8002.log
StandardError=append:/home/base-node/.codex_tasks/pixelml-cmp170hx/fp8-baseline-8002.log

[Install]
WantedBy=default.target
