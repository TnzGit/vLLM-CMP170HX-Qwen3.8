# Experimental only: do not use as the production systemd profile yet.
# This file documents the target runtime contract for the mixed-FP8 work.

SPEC=dflash2
CTX=fast
DFLASH_TOKENS=7

# Target model path and DFlash2 draft path are host-specific.
MODEL=/models/Qwen3.8-27B-W4A16-AutoRound-fast
DRAFT=/models/Qwen3.8-27B-DFlash2-W4A16

# Target cache/backend.
CMP_TARGET_ATTN_BACKEND=FLASHINFER
CMP_TARGET_KV_DTYPE=fp8

# Draft-specific overrides to wire into speculative_config.
DFLASH_ATTN_BACKEND=FLASH_ATTN
DFLASH_KV_CACHE_DTYPE=bfloat16

# Split-KV verifier gates. The normal syv split-KV gate is still required.
VLLM_SPEC_DECODE_ATTN=1
VLLM_FP8_SPEC_VERIFY=1

# Keep this disabled until eager correctness, repeated-prefix correctness and
# high-block-id stress all pass. The Reddit configuration used an additional
# full-CUDA-graph gate; that behavior is not yet reconstructed here.
VLLM_FP8_SPEC_FULL_CG=0

# Heterogeneous-page alignment is a target behavior, not yet enabled by this
# first implementation slice. Do not assume setting the variable alone changes
# allocator geometry.
VLLM_ALIGN_HETEROGENEOUS_ATTN_PAGES=0

# Qualification starts at ordinary context sizes. Move upward only after the
# regression matrix passes.
MAX_LEN=65536
MAX_SEQS=1
GPU_UTIL=0.90
