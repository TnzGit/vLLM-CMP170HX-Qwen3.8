             s = tl.dot(qs, tl.trans(k)).to(tl.float32) * k_sc[None, :]
+        elif STATIC_QUANT:
+            # Static per-layer FP8 cache (E4M3/E5M2). Triton converts loaded
+            # FP8 values to BF16 before the tensor-core dot. vLLM's cache
+            # writer stored value/scale, so restore the K scale here.
+            k = k.to(tl.bfloat16)
+            v = v.to(tl.bfloat16)
+            s = tl.dot(qs, tl.trans(k)).to(tl.float32) * static_k_scale
         else:
             s = tl.dot(qs, tl.trans(k)).to(tl.float32)            # [BLOCK_M, TILE]
