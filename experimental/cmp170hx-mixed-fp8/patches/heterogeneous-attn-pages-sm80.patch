+def _align_heterogeneous_attention_page_sizes(
+    kv_cache_spec: dict[str, KVCacheSpec],
+) -> dict[str, KVCacheSpec]:
+    """Opt-in fixed-point alignment for mixed target/draft attention pages.
+
+    A hybrid model may first grow the target attention block to cover a Mamba
+    page, then grow a BF16 draft page slightly beyond that target page. The
+    ordinary one-pass unifier pads the target's physical page but keeps its
+    smaller logical block, which cannot be represented as one affine
+    ``as_strided`` view after splitting it into backend kernel blocks.

+    Grow attention block sizes in their shared kernel granularity until every
+    natural attention page covers the current maximum. For the CMP mixed-FP8
+    profile this converges from target=880/draft=16 to target=896/draft=448,
+    both exactly 1,835,008 bytes. Mamba pages are padded later by the normal
+    unifier. The behavior is strictly opt-in while being qualified.
+    """
+    if os.environ.get("VLLM_ALIGN_HETEROGENEOUS_ATTN_PAGES", "0") != "1":
+        return kv_cache_spec
+
+    attention_specs = [
+        spec for spec in kv_cache_spec.values() if isinstance(spec, AttentionSpec)
+    ]
+    if len(attention_specs) < 2:
+        return kv_cache_spec
+
+    granularity = 0
+    for spec in attention_specs:
+        granularity = math.gcd(granularity, spec.block_size)
+    if granularity <= 0:
+        return kv_cache_spec
+
+    updated = dict(kv_cache_spec)
+    max_rounds = len(attention_specs) + 4
+    for _ in range(max_rounds):
+        max_page_size = max(spec.page_size_bytes for spec in updated.values())
+        changed = False
+        for layer_name, spec in tuple(updated.items()):
+            if not isinstance(spec, AttentionSpec):
+                continue
+            if spec.unpadded_page_size_bytes % spec.block_size != 0:
+                raise ValueError(
+                    f"Layer {layer_name} has a non-integral attention page size"
+                )
+            bytes_per_token = spec.unpadded_page_size_bytes // spec.block_size
+            required_tokens = cdiv(max_page_size, bytes_per_token)
+            new_block_size = round_up(required_tokens, granularity)
+            if new_block_size <= spec.block_size:
+                continue
+            new_spec = replace(
+                spec,
+                block_size=new_block_size,
+                page_size_padded=None,
+            )
+            logger.info(
+                "Mixed-FP8 page alignment raised %s from %d to %d tokens "
+                "(%d B natural page; granularity %d).",
+                layer_name,
+                spec.block_size,
+                new_block_size,
+                new_spec.page_size_bytes,
+                granularity,
+            )
+            updated[layer_name] = new_spec
+            changed = True
+        if not changed:
+            return updated
+
+    raise RuntimeError("Mixed-FP8 attention page alignment did not converge")
+
+
