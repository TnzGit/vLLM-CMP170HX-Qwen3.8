 @triton.jit
-def _e4m3fn_to_fp32(raw):
-    """Decode NVIDIA E4M3FN bytes on SM80, where Triton cannot load fp8e4nv."""
-    bits = raw.to(tl.uint32)
-    sign = 1.0 - 2.0 * ((bits >> 7) & 1).to(tl.float32)
-    exponent = (bits >> 3) & 0xF
-    mantissa = bits & 0x7
-    normal = (1.0 + mantissa.to(tl.float32) * 0.125) * tl.exp2(
-        exponent.to(tl.float32) - 7.0
-    )
-    subnormal = mantissa.to(tl.float32) * (2.0**-9)
-    value = tl.where(exponent == 0, subnormal, normal) * sign
-    # E4M3FN reserves only exp=15,mantissa=7 for NaN. Cached K/V should be
-    # finite; map any unexpected NaN encoding to zero instead of poisoning a
-    # full attention row.
-    return tl.where((exponent == 0xF) & (mantissa == 0x7), 0.0, value)
+def _e4m3fn_to_bf16(raw, lut_ptr):
+    """Decode E4M3FN through an exact BF16 LUT that remains hot in L1/L2."""
+    return tl.load(lut_ptr + raw.to(tl.int32))
+
+
+def _build_e4m3fn_lut() -> list[float]:
+    values: list[float] = []
+    for byte in range(256):
+        sign = -1.0 if byte & 0x80 else 1.0
+        exponent = (byte >> 3) & 0xF
+        mantissa = byte & 0x7
+        if exponent == 0xF and mantissa == 0x7:
+            value = 0.0
+        elif exponent == 0:
+            value = mantissa * (2.0**-9)
+        else:
+            value = (1.0 + mantissa * 0.125) * (2.0 ** (exponent - 7))
+        values.append(sign * value)
+    return values
 
 
