             # Seed the running state block from the resumed/prefilled position.
             self._mamba_state_idx_gpu[req_index].fill_(
-                (new_req_data.num_computed_tokens - 1) // self.cache_config.block_size
+                # Mamba states are checkpointed every mamba_block_size tokens. cache_config.block_size is
+                # lowered to the smallest KV group after the cache layout is built (a DFlash drafter's
+                # 416-token pages against Mamba's 832), so it must not index the state here.
+                (new_req_data.num_computed_tokens - 1)
+                // (self.cache_config.mamba_block_size or self.cache_config.block_size)
             )
 
